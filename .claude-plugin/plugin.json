{
  "name": "human-autocomplete",
  "version": "0.1.0",
  "description": "Your agent writes the signature and the failing tests; you get to finish the function. Now and then it hands you one real function from the task at hand, and writes it itself if you don't pick it up within 20 minutes.",
  "author": {
    "name": "Alexey Verein",
    "url": "https://github.com/aleks-tpom6oh"
  },
  "homepage": "https://github.com/aleks-tpom6oh/human-autocomplete",
  "repository": "https://github.com/aleks-tpom6oh/human-autocomplete",
  "license": "MIT",
  "keywords": ["practice", "coding", "kata", "focus", "skills"],
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/hand-code/scripts/handcode\" hook",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
